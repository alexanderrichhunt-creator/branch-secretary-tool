FLASK_ENV=development
SECRET_KEY=change-me

# SQLite for local dev (recommended)
DATABASE_URL=sqlite:///data.db

# Create the first admin user automatically on first run (optional)
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=change-me

# Optional: email password reset links (if unset, users should ask an admin to reset)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@example.com
